APP_NAME="Supermarket Goods Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=supermarket_goods
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------

SHOP_NAME="Supermarket Goods Hub"
SHOP_TAGLINE="Fresh goods, fairly priced, every day."
SHOP_PHONE="09 380 000 00"
SHOP_ADDRESS="No. 12, Baho Road, Kamayut, Yangon"
SHOP_CURRENCY=MMK
SHOP_CURRENCY_SYMBOL=Ks
SHOP_ORDER_PREFIX=GGS

# Delivery is quoted per zone at checkout; the fee is free above the threshold.
SHOP_DELIVERY_FEE_INNER=1500
SHOP_DELIVERY_FEE_METRO=2500
SHOP_DELIVERY_FEE_UPCOUNTRY=5000
SHOP_DELIVERY_FREE_OVER=150000

# Freshness
SHOP_EXPIRING_SOON_DAYS=30
SHOP_NEW_ARRIVAL_DAYS=30

# Homepage advertising
SHOP_HERO_HEADLINE="Fill your basket, not your budget"
SHOP_HERO_SUBLINE="Fresh produce, meat and pantry staples with weekly promotions, delivered across Yangon and beyond."
SHOP_HERO_CTA="Shop the weekly deals"

# Homepage carousel. Product slides are picked automatically; PROMO_VIDEO is an
# optional advertisement that becomes the first slide once the file exists in
# storage/app/public/promo/ (an .mp4 or .webm).
PROMO_SLIDES=5
PROMO_AUTOPLAY_MS=6000
PROMO_VIDEO=
PROMO_VIDEO_POSTER=
PROMO_VIDEO_TITLE="This week at the store"

# Seeded catalogue prices are written in a round source currency and converted
# to kyat by this factor when you run `php artisan db:seed`.
SEED_PRICE_FACTOR=45

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# "sandbox" simulates a provider so the whole cart -> checkout -> payment flow
# can be exercised without merchant credentials. A live gateway only appears at
# the checkout once it is both enabled and completely configured.

PAYMENTS_DRIVER=sandbox
PAYMENTS_SANDBOX_ENABLED=true

# KBZPay
KBZPAY_ENABLED=false
KBZPAY_MERCH_CODE=
KBZPAY_MERCHANT_ID=
KBZPAY_APP_ID=
KBZPAY_SECRET=
KBZPAY_TRADE_TYPE=APP

# AyaPay
AYAPAY_ENABLED=false
AYAPAY_MERCHANT_ID=
AYAPAY_MERCHANT_KEY=

# Wave Money
WAVEMONEY_ENABLED=false
WAVEMONEY_MERCHANT_ID=
WAVEMONEY_API_KEY=
WAVEMONEY_API_SECRET=

# UAB Pay
UABPAY_ENABLED=false
UABPAY_MERCHANT_ID=
UABPAY_USERNAME=
UABPAY_PASSWORD=

